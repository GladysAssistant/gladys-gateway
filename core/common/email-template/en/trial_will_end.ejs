<%- include('../partials/head', { title: 'Your Gladys Plus trial is ending soon', preheader: 'Add a payment method to keep your subscription active.' }) %>
                    <h1 class="gl-h1" style="<%- s.h1 %>">Your trial ends on <%= trialEndDate %></h1>

                    <p class="gl-p" style="<%- s.p %>">
                      <% if (firstname) { %>Hi <%= firstname %>,<% } else { %>Hi there,<% } %>
                    </p>

                    <p class="gl-p" style="<%- s.p %>">
                      Your free <%= planProductName %> trial ends on <strong><%= trialEndDate %></strong>.
                      <% if (amount) { %>To keep your subscription active at <strong><%= amount %></strong>, add a payment method using the button below. You'll keep:<% } else { %>To keep using Gladys Plus, add a payment method using the button below. You'll keep:<% } %>
                    </p>

<%- include('../partials/benefits', { items: planBenefits }) %>
<%- include('../partials/button', { url: updateCardLink, label: 'Keep Gladys Plus active' }) %>
<%- include('../partials/link-fallback', { url: updateCardLink }) %>
                    <p class="gl-p" style="<%- s.p %>">
                      Haven't finished setting everything up? Reply to this email and I'm happy to extend your trial by a few days.
                    </p>

<%- include('../partials/footer') %>
