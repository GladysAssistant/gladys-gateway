<%- include('../partials/head', { title: 'Ton abonnement Gladys Plus se renouvelle bientôt', preheader: "Rien à faire pour continuer, et tu peux y mettre fin à tout moment." }) %>
                    <h1 class="gl-h1" style="<%- s.h1 %>">Ton abonnement se renouvelle le <%= renewalDate %></h1>

                    <p class="gl-p" style="<%- s.p %>">
                      <% if (firstname) { %>Salut <%= firstname %>,<% } else { %>Salut,<% } %>
                    </p>

                    <p class="gl-p" style="<%- s.p %>">
                      Ton abonnement annuel <%= planProductName %> sera reconduit automatiquement le
                      <strong><%= renewalDate %></strong><% if (amount) { %>, pour un montant de <strong><%= amount %></strong><% } %>.
                      Tu n'as rien à faire pour continuer, et tu gardes :
                    </p>

<%- include('../partials/benefits', { items: planBenefits }) %>
<%- include('../partials/tile-start', { variant: 'neutral' }) %>
                          <strong>Si tu ne souhaites pas reconduire ton abonnement</strong>, tu peux y mettre fin à tout moment
                          avant cette date, en un clic depuis ton espace de gestion. Ton abonnement restera actif jusqu'au
                          <%= renewalDate %> et ne sera pas renouvelé.
<%- include('../partials/tile-end') %>
<%- include('../partials/button', { url: manageSubscriptionLink, label: 'Gérer mon abonnement' }) %>
<%- include('../partials/link-fallback', { url: manageSubscriptionLink }) %>
                    <p class="gl-p" style="<%- s.p %>">
                      C'est aussi le bon endroit pour mettre à jour ta carte bancaire si elle a expiré, et pour récupérer
                      tes factures.
                    </p>

                    <p class="gl-p" style="<%- s.p %>">
                      Une question ? Réponds simplement à cet email.
                    </p>

<%- include('../partials/footer') %>
