<%- include('../partials/head', { title: 'Ton essai Gladys Plus se termine bientôt', preheader: 'Ajoute un moyen de paiement pour garder ton abonnement actif.' }) %>
                    <h1 class="gl-h1" style="<%- s.h1 %>">Ton essai se termine le <%= trialEndDate %></h1>

                    <p class="gl-p" style="<%- s.p %>">
                      <% if (firstname) { %>Salut <%= firstname %>,<% } else { %>Salut,<% } %>
                    </p>

                    <p class="gl-p" style="<%- s.p %>">
                      Ton essai gratuit <%= planProductName %> se termine le <strong><%= trialEndDate %></strong>.
                      <% if (amount) { %>Pour garder ton abonnement actif à <strong><%= amount %></strong>, ajoute un moyen de paiement via le bouton ci-dessous. Tu garderas :<% } else { %>Pour continuer à utiliser Gladys Plus, ajoute un moyen de paiement via le bouton ci-dessous. Tu garderas :<% } %>
                    </p>

<%- include('../partials/benefits', { items: planBenefits }) %>
<%- include('../partials/button', { url: updateCardLink, label: 'Garder Gladys Plus actif' }) %>
<%- include('../partials/link-fallback', { url: updateCardLink }) %>
                    <p class="gl-p" style="<%- s.p %>">
                      Tu n'as pas eu le temps de tout configurer ? Réponds à cet email et je peux te prolonger l'essai de quelques jours.
                    </p>

<%- include('../partials/footer') %>
