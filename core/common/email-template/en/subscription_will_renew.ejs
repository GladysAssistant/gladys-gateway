<%- include('../partials/head', { title: 'Your Gladys Plus subscription renews soon', preheader: 'Nothing to do to keep it running, and you can cancel any time.' }) %>
                    <h1 class="gl-h1" style="<%- s.h1 %>">Your subscription renews on <%= renewalDate %></h1>

                    <p class="gl-p" style="<%- s.p %>">
                      <% if (firstname) { %>Hi <%= firstname %>,<% } else { %>Hi,<% } %>
                    </p>

                    <p class="gl-p" style="<%- s.p %>">
                      Your yearly <%= planProductName %> subscription will renew automatically on
                      <strong><%= renewalDate %></strong><% if (amount) { %>, for <strong><%= amount %></strong><% } %>.
                      There is nothing to do to keep it running, and you keep:
                    </p>

<%- include('../partials/benefits', { items: planBenefits }) %>
<%- include('../partials/tile-start', { variant: 'neutral' }) %>
                          <strong>If you would rather not renew</strong>, you can cancel at any time before that date, in one
                          click from your billing area. Your subscription will stay active until <%= renewalDate %> and will
                          not be renewed.
<%- include('../partials/tile-end') %>
<%- include('../partials/button', { url: manageSubscriptionLink, label: 'Manage my subscription' }) %>
<%- include('../partials/link-fallback', { url: manageSubscriptionLink }) %>
                    <p class="gl-p" style="<%- s.p %>">
                      It is also the right place to update your card if it has expired, and to download your invoices.
                    </p>

                    <p class="gl-p" style="<%- s.p %>">
                      Any question? Just reply to this email.
                    </p>

<%- include('../partials/footer') %>
