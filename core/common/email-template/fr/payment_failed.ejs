<%- include('../partials/head', { title: 'Mets à jour ta carte pour garder Gladys Plus', preheader: "Le prélèvement n'est pas passé. C'est rapide à corriger." }) %>
                    <h1 class="gl-h1" style="<%- s.h1 %>">Mets à jour ton moyen de paiement</h1>

                    <p class="gl-p" style="<%- s.p %>">
                      <% if (firstname) { %>Salut <%= firstname %>,<% } else { %>Salut,<% } %>
                    </p>

                    <p class="gl-p" style="<%- s.p %>">
                      Nous n'avons pas pu prélever <strong><%= amount %></strong> pour ton abonnement Gladys Plus <%= planName %> le <%= attemptDate %>.
                      Cela arrive souvent quand une carte a expiré ou atteint son plafond. C'est rapide à corriger.
                    </p>

<%- include('../partials/tile-start', { variant: 'warning' }) %>
                          Sans mise à jour, ton accès à distance, tes sauvegardes et les autres fonctionnalités Gladys Plus pourraient être interrompus<% if (nextRetryDate) { %>.
                          Nous réessaierons automatiquement le <strong><%= nextRetryDate %></strong>.<% } else { %>.<% } %>
<%- include('../partials/tile-end') %>
<%- include('../partials/button', { url: updateCardLink, label: 'Mettre à jour mon moyen de paiement' }) %>
<%- include('../partials/link-fallback', { url: updateCardLink }) %>
<% if (hostedInvoiceUrl) { %>
                    <p class="gl-p" style="<%- s.p %>">
                      Tu peux aussi
                      <a href="<%= hostedInvoiceUrl %>" class="gl-link" style="<%- s.link %>">consulter ta facture</a>.
                    </p>
<% } %>
                    <p class="gl-p" style="<%- s.p %>">
                      Besoin d'aide ? Réponds à cet email ou contacte-moi à
                      <a href="mailto:hello@gladysassistant.com" class="gl-link" style="<%- s.link %>">hello@gladysassistant.com</a>.
                    </p>

<%- include('../partials/footer') %>
