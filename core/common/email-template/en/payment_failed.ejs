<%- include('../partials/head', { title: 'Action needed: update your payment method', preheader: "Your payment didn't go through. It's quick to fix." }) %>
                    <h1 class="gl-h1" style="<%- s.h1 %>">Action needed: update your payment method</h1>

                    <p class="gl-p" style="<%- s.p %>">
                      <% if (firstname) { %>Hi <%= firstname %>,<% } else { %>Hi there,<% } %>
                    </p>

                    <p class="gl-p" style="<%- s.p %>">
                      We couldn't charge <strong><%= amount %></strong> for your <%= planProductName %> subscription on <%= attemptDate %>.
                      This usually happens when a card has expired or hit its spending limit. It's quick to fix.
                    </p>

<%- include('../partials/tile-start', { variant: 'warning' }) %>
                          Without an update, your remote access, backups, and other Gladys Plus features may be interrupted<% if (nextRetryDate) { %>.
                          We'll automatically retry on <strong><%= nextRetryDate %></strong>.<% } else { %>.<% } %>
<%- include('../partials/tile-end') %>
<%- include('../partials/button', { url: updateCardLink, label: 'Update payment method' }) %>
<%- include('../partials/link-fallback', { url: updateCardLink }) %>
<% if (hostedInvoiceUrl) { %>
                    <p class="gl-p" style="<%- s.p %>">
                      You can also
                      <a href="<%= hostedInvoiceUrl %>" class="gl-link" style="<%- s.link %>">view your invoice</a>.
                    </p>
<% } %>
                    <p class="gl-p" style="<%- s.p %>">
                      Need help? Just reply to this email or contact me at
                      <a href="mailto:hello@gladysassistant.com" class="gl-link" style="<%- s.link %>">hello@gladysassistant.com</a>.
                    </p>

<%- include('../partials/footer') %>
