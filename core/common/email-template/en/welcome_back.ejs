<%- include('../partials/head', { title: 'Gladys Plus - Welcome back!', preheader: 'Your existing account has been linked to your new subscription.' }) %>
                    <h1 class="gl-h1" style="<%- s.h1 %>">Welcome back to Gladys Plus!</h1>

                    <p class="gl-p" style="<%- s.p %>">
                      Thanks for subscribing again to Gladys Plus! 🙏
                    </p>

                    <p class="gl-p" style="<%- s.p %>">
                      Your existing Gladys Plus account has been linked to your new subscription: there is no new account to create.
                      Log in with the email address and the password of your previous subscription:
                    </p>

<%- include('../partials/button', { url: loginUrl, label: 'Log in to Gladys Plus' }) %>
<%- include('../partials/link-fallback', { url: loginUrl }) %>
<%- include('../partials/tile-start', { variant: 'neutral' }) %>
                          <strong>Don't remember your password?</strong>
                          That's normal after a break. <a href="<%= forgotPasswordUrl %>" class="gl-link" style="<%- s.link %>">Choose a new one</a>:
                          you will receive a link by email.
<%- include('../partials/tile-end') %>
<%- include('../partials/tile-start', { variant: 'neutral' }) %>
                          <strong>Lost access to your two-factor authentication?</strong>
                          Use one of your <strong>recovery codes</strong> instead of the code of your app.
                          If you have run out, or never generated any, an admin of your Gladys can generate new ones from
                          Settings › Users. No Gladys connected? Use the reset by email link under the code field, when
                          you sign in or on the new password page: you will receive a link to reset your two-factor
                          authentication.
<%- include('../partials/tile-end') %>
<%- include('../partials/footer') %>
