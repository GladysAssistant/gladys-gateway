<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; box-sizing: border-box; font-size: 14px; margin: 0;">
<head>
  <meta name="viewport" content="width=device-width" />
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
  <title>Ton kit de démarrage Gladys avance</title>
</head>
<body style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; box-sizing: border-box; font-size: 14px; -webkit-font-smoothing: antialiased; -webkit-text-size-adjust: none; width: 100% !important; height: 100%; line-height: 1.6em; background-color: #f6f6f6; margin: 0;" bgcolor="#f6f6f6">
  <table width="100%" cellpadding="0" cellspacing="0" style="background-color: #f6f6f6;" bgcolor="#f6f6f6">
    <tr>
      <td></td>
      <td width="600" style="display: block !important; max-width: 600px !important; clear: both !important; margin: 0 auto;">
        <div style="max-width: 600px; display: block; margin: 0 auto; padding: 20px;">
          <table width="100%" cellpadding="0" cellspacing="0" style="border-radius: 3px; background-color: #fff; border: 1px solid #e9e9e9;" bgcolor="#fff">
            <tr>
              <td style="padding: 20px;" valign="top">
                <h1 style="font-family: 'Helvetica Neue', Helvetica, Arial, 'Lucida Grande', sans-serif; font-size: 32px; line-height: 1.2; color: #000; font-weight: 200; margin: 10px 0 20px; padding: 0;">
                  Ta commande avance 🚀
                </h1>

                <p style="margin: 0 0 20px;">
                  <% if (firstname) { %>Salut <%= firstname %>,<% } else { %>Salut,<% } %>
                </p>

                <p style="margin: 0 0 20px;">
                  Petite mise à jour de ta commande de kit de démarrage : <strong><%= statusLabel %></strong>.
                </p>
<% if (status === 'mini_pc_ordered') { %>                <p style="margin: 0 0 20px;">
                  J'ai commandé ton mini-PC<% if (miniPcExpectedAt) { %>, je devrais le recevoir le <strong><%= miniPcExpectedAt %></strong><% } %>. Je m'occuperai de l'installation de Gladys dès sa réception.
                </p>
<% } %>
<% if (status === 'installed') { %>                <p style="margin: 0 0 20px;">
                  Gladys est installée sur ton mini-PC, il est prêt à partir !
                </p>
<% if (pickupPointSelected) { %>                <p style="margin: 0 0 20px;">
                  Il sera livré au point relais <strong><%= pickupPoint.name %></strong>, je t'enverrai le numéro de suivi dès qu'il sera expédié.
                </p>
<% } else { %>                <p style="margin: 0 0 20px;">
                  Il ne manque plus que ton point relais Mondial Relay pour l'expédier :
                </p>
<% if (trackingUrl) { %>
                <p style="margin: 0 0 24px;">
                  <a href="<%= trackingUrl %>" style="font-size: 14px; color: #fff; text-decoration: none; line-height: 2em; font-weight: bold; text-align: center; cursor: pointer; display: inline-block; border-radius: 5px; background-color: #348eda; border-color: #348eda; border-style: solid; border-width: 10px 20px;">
                    Choisir mon point relais
                  </a>
                </p>
<% } %>
<% } %>
<% } %>
<% if (trackingUrl) { %>                <p style="margin: 0 0 20px;">
                  Tu peux suivre l'avancement de ta commande à tout moment sur ta page de suivi :<br /><a href="<%= trackingUrl %>"><%= trackingUrl %></a>
                </p>
<% } %>

                <p style="margin: 0 0 20px;">
                  Une question ? Réponds simplement à cet email ou écris-moi à
                  <a href="mailto:hello@gladysassistant.com">hello@gladysassistant.com</a>.
                </p>

                <p style="margin: 0 0 20px;">
                  Pierre-Gilles Leymarie, fondateur de Gladys Assistant
                </p>
              </td>
            </tr>
          </table>
        </div>
      </td>
      <td></td>
    </tr>
  </table>
</body>
</html>
