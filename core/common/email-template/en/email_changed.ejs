<%- include('../partials/head', { title: 'Gladys Plus - Your email address was changed', preheader: 'The email address of your Gladys Plus account was just changed.' }) %>
                    <h1 class="gl-h1" style="<%- s.h1 %>">Your email address was changed</h1>

                    <p class="gl-p" style="<%- s.p %>">
                      The email address of your Gladys Plus account was just changed to <strong><%= newEmail %></strong>. This address will no longer receive emails about your account (password reset, billing, etc.).
                    </p>

                    <p class="gl-p" style="<%- s.p %>">
                      If you made this change, you can safely ignore this email.
                    </p>

<%- include('../partials/tile-start', { variant: 'danger' }) %>
                          <strong>If you did not make this change, your account may be compromised.</strong>
                          Reply to this email immediately so I can secure your account.
<%- include('../partials/tile-end') %>
<%- include('../partials/footer') %>
