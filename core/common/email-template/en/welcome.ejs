<%- include('../partials/head', { title: 'Welcome to Gladys Plus', preheader: 'Activate your account and connect your Gladys instance in a few minutes.' }) %>
                    <h1 class="gl-h1" style="<%- s.h1 %>">Welcome to <%= planProductName %>!</h1>

                    <p class="gl-p" style="<%- s.p %>">
                      <% if (firstname) { %>Hi <%= firstname %>,<% } else { %>Hi there,<% } %>
                    </p>

                    <p class="gl-p" style="<%- s.p %>">
                      Thanks for joining Gladys Plus! Here is how to get started.
                    </p>

<% if (hasTrial) { %>
<%- include('../partials/tile-start', { variant: 'success' }) %>
                          You have a <strong>free trial</strong> with no credit card required<% if (trialEndDate) { %>, until <strong><%= trialEndDate %></strong><% } %>.
                          We'll email you before it ends so you can add a payment method if you want to continue.
<%- include('../partials/tile-end') %>
<% } %>

                    <p class="gl-label" style="<%- s.label %>">Get started in a few steps</p>

<%- include('../partials/steps', { items: welcomeSteps }) %>
<%- include('../partials/button', { url: confirmationUrlGladys4, label: 'Activate your Gladys Plus account' }) %>
<%- include('../partials/link-fallback', { url: confirmationUrlGladys4 }) %>
                    <p class="gl-p" style="<%- s.p %>">
                      We won't be able to support this project without you, so a special thanks for using Gladys Plus! 🙏
                    </p>

                    <p class="gl-p" style="<%- s.p %>">
                      Questions or feedback? Reply to this email or write me at
                      <a href="mailto:hello@gladysassistant.com" class="gl-link" style="<%- s.link %>">hello@gladysassistant.com</a>.
                    </p>

<%- include('../partials/footer') %>
