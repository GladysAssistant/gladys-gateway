<%- include('../partials/head', { title: 'Gladys Plus - Reset your two-factor authentication', preheader: 'A link to reset the two-factor authentication of your Gladys Plus account.' }) %>
                    <h1 class="gl-h1" style="<%- s.h1 %>">Reset your two-factor authentication</h1>

                    <p class="gl-p" style="<%- s.p %>">
                      <% if (firstname) { %>Hi <%= firstname %>,<% } else { %>Hi,<% } %>
                    </p>

                    <p class="gl-p" style="<%- s.p %>">
                      You asked to reset the two-factor authentication of your Gladys Plus account because you lost access to your authenticator app and to your recovery codes.
                      Here is the link to do it. It works once and expires in one hour.
                    </p>

<%- include('../partials/button', { url: twoFactorResetUrlGladys4, label: 'Reset my two-factor authentication' }) %>
<%- include('../partials/link-fallback', { url: twoFactorResetUrlGladys4 }) %>
                    <p class="gl-p" style="<%- s.p %>">
                      Once done, sign in again with your password: Gladys Plus will ask you to set up a new authenticator app, then to save new recovery codes.
                    </p>

<%- include('../partials/tile-start', { variant: 'danger' }) %>
                          <strong>If you did not ask for this, do not click the link and change your password now.</strong>
                          Someone who knows your password is trying to get into your account. Reply to this email so I can secure it.
<%- include('../partials/tile-end') %>
<%- include('../partials/footer') %>
